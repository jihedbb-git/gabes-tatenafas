{
  "name": "nafass",
  "productName": "Nafass",
  "version": "1.0.0",
  "description": "Nafass — نَفَس · Surveillance santé & qualité de l'air à Gabès (Electron + PHP + MySQL).",
  "private": true,
  "main": "electron/main.js",
  "author": "Gabes Tatenafas Team <yeargem@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron electron/main.js",
    "dev": "electron electron/main.js --enable-logging",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nafass.gabes",
    "productName": "Nafass",
    "copyright": "Copyright © 2025 Gabes Tatenafas Team",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/icon.svg",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nafass",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Nafass-${version}-portable.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.healthcare-fitness"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "type": "commonjs"
}
